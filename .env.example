# HTTP server port (1-65535).
PORT=8080

# Required at runtime: set a private random Bearer key without whitespace.
# Never commit the key or add it to a Docker image.
API_KEY=

# Storage engine selected once at startup: chained, recursive or go-map.
CACHE_ENGINE=chained
# Initial bucket count for chained only; ignored by recursive and go-map.
CACHE_BUCKET_COUNT=16
# Provisional key/value limits in bytes, shared by every engine.
MAX_KEY_BYTES=256
MAX_VALUE_BYTES=1048576

# Provisional full HTTP request body limit in bytes.
MAX_BODY_BYTES=8388608
# Provisional graceful shutdown timeout as a positive Go duration.
SHUTDOWN_TIMEOUT=10s
