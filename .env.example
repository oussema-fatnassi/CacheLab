# HTTP server port
PORT=8080

# Required at runtime: generate a private random key before starting the server.
# Never commit the key or add it to a Docker image.
API_KEY=

# Provisional cache limits and initial number of buckets
CACHE_BUCKET_COUNT=16
MAX_KEY_BYTES=256
MAX_VALUE_BYTES=1048576

# Provisional HTTP body limit and graceful shutdown timeout
MAX_BODY_BYTES=8388608
SHUTDOWN_TIMEOUT=10s
